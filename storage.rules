rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /admin_profiles/{adminId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == adminId
        && request.auth.token.email in [
          'admin@visiongrade.edu',
          'bruce.admin@visiongrade.edu'
        ]
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /task_instructions/{subjectId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /hardcopy_scans/{subjectId}/{taskId}/{fileName} {
      allow read, write: if request.auth != null;
    }

    match /subject_thumbnails/{fileName} {
      allow read, write: if request.auth != null;
    }
  }
}