rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDashboardAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'admin@visiongrade.edu',
          'bruce.admin@visiongrade.edu'
        ];
    }

    function isDashboardAdminProfile(profileId) {
      return isDashboardAdmin()
        && request.auth.uid == profileId;
    }

    function isAuthenticatedAs(email) {
      return request.auth != null
        && request.auth.token.email is string
        && email is string
        && email.lower() == request.auth.token.email.lower();
    }

    function managesTask(subjectId, postId) {
      let subject = get(
        /databases/$(database)/documents/subjects/$(subjectId)
      ).data;
      let post = get(
        /databases/$(database)/documents/subjects/$(subjectId)/posts/$(postId)
      ).data;
      return isAuthenticatedAs(subject.instructorEmail)
        || isAuthenticatedAs(post.posterEmail);
    }

    match /instructor_accounts/{accountId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDashboardAdmin();
      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnline', 'lastSeen', 'role', 'authUid'])
        && (!('authUid' in request.resource.data)
          || request.resource.data.authUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phoneNumber', 'gender', 'profileImageUrl', 'photoUrl']);
    }

    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDashboardAdmin();
      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isOnline', 'lastSeen', 'role', 'authUid'])
        && (!('authUid' in request.resource.data)
          || request.resource.data.authUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phoneNumber', 'gender', 'profileImageUrl', 'photoUrl']);
    }

    match /admin_profiles/{profileId} {
      allow get: if isDashboardAdminProfile(profileId);
      allow create, update: if isDashboardAdminProfile(profileId)
        && request.resource.data.keys().hasOnly([
          'name', 'role', 'photoURL', 'updatedAt'
        ])
        && (!('name' in request.resource.data)
          || request.resource.data.name is string)
        && (!('role' in request.resource.data)
          || request.resource.data.role in [
            'Global Admin', 'Department Head', 'Registrar'
          ])
        && (!('photoURL' in request.resource.data)
          || request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 950000)
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp);
    }

    match /support_messages/{messageId} {
      allow read: if isDashboardAdmin();
      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email
        && request.resource.data.senderRole in ['student', 'instructor']
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.senderName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status == 'unread';
      allow update, delete: if isDashboardAdmin();
    }

    match /system_counters/{counterId} {
      allow get: if isDashboardAdmin()
        && counterId.matches('^student_ids_[0-9]{4}$');
      allow create, update: if isDashboardAdmin()
        && counterId.matches('^student_ids_[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['year', 'lastSequence'])
        && request.resource.data.year is int
        && request.resource.data.lastSequence is int
        && request.resource.data.lastSequence >= 0;
    }

    match /global_announcements/{announcementId} {
      allow read: if isDashboardAdmin()
        || request.auth != null
          && (
            resource.data.get('isGlobalAnnouncement', false) == true
            || request.auth.uid in resource.data.get('targetStudentUids', [])
            || request.auth.uid in resource.data.get('targetInstructorUids', [])
            || request.auth.uid in resource.data.get('targetStudentProfileIds', [])
            || request.auth.uid in resource.data.get('targetInstructorProfileIds', [])
            || request.auth.token.email is string
              && (
                request.auth.token.email.lower()
                  in resource.data.get('targetStudentEmails', [])
                || request.auth.token.email.lower()
                  in resource.data.get('targetInstructorEmails', [])
              )
          );
      allow create: if isDashboardAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'author', 'authorEmail', 'posterName',
          'posterEmail', 'type', 'isGlobalAnnouncement', 'recipientMode',
          'targetStudentEmails', 'targetStudentNames',
          'targetInstructorEmails', 'targetInstructorNames',
          'targetStudentIds', 'targetInstructorIds',
          'targetStudentProfileIds', 'targetInstructorProfileIds',
          'targetStudentUids', 'targetInstructorUids',
          'recipientRoles', 'postedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.type == 'Announcement'
        && request.resource.data.recipientMode in ['all', 'selected']
        && request.resource.data.targetStudentEmails is list
        && request.resource.data.targetStudentNames is list
        && request.resource.data.targetInstructorEmails is list
        && request.resource.data.targetInstructorNames is list
        && request.resource.data.targetStudentIds is list
        && request.resource.data.targetInstructorIds is list
        && request.resource.data.targetStudentProfileIds is list
        && request.resource.data.targetInstructorProfileIds is list
        && request.resource.data.targetStudentUids is list
        && request.resource.data.targetInstructorUids is list
        && request.resource.data.recipientRoles is list
        && request.resource.data.targetStudentEmails.size() <= 500
        && request.resource.data.targetInstructorEmails.size() <= 500
        && request.resource.data.targetStudentIds.size() <= 500
        && request.resource.data.targetInstructorIds.size() <= 500
        && request.resource.data.targetStudentProfileIds.size() <= 500
        && request.resource.data.targetInstructorProfileIds.size() <= 500
        && request.resource.data.targetStudentUids.size() <= 500
        && request.resource.data.targetInstructorUids.size() <= 500
        && (
          request.resource.data.recipientMode == 'all'
            && request.resource.data.isGlobalAnnouncement == true
            && request.resource.data.targetStudentEmails.size() == 0
            && request.resource.data.targetInstructorEmails.size() == 0
            && request.resource.data.targetStudentIds.size() == 0
            && request.resource.data.targetInstructorIds.size() == 0
            && request.resource.data.targetStudentProfileIds.size() == 0
            && request.resource.data.targetInstructorProfileIds.size() == 0
            && request.resource.data.targetStudentUids.size() == 0
            && request.resource.data.targetInstructorUids.size() == 0
            && request.resource.data.recipientRoles.size() == 0
          || request.resource.data.recipientMode == 'selected'
            && request.resource.data.isGlobalAnnouncement == false
            && (
              request.resource.data.targetStudentEmails.size() > 0
              || request.resource.data.targetInstructorEmails.size() > 0
              || request.resource.data.targetStudentIds.size() > 0
              || request.resource.data.targetInstructorIds.size() > 0
              || request.resource.data.targetStudentProfileIds.size() > 0
              || request.resource.data.targetInstructorProfileIds.size() > 0
              || request.resource.data.targetStudentUids.size() > 0
              || request.resource.data.targetInstructorUids.size() > 0
            )
        )
        && request.resource.data.postedAt is timestamp;
      allow update, delete: if isDashboardAdmin();

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorEmail == request.auth.token.email
          && request.resource.data.authorRole in ['Teacher', 'Student']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;
        allow update, delete: if request.auth != null
          && resource.data.authorEmail == request.auth.token.email;
      }
    }

    match /subjects/{subjectId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDashboardAdmin();
      allow update: if request.auth != null
        && resource.data.instructorEmail is string
        && request.auth.token.email is string
        && resource.data.instructorEmail.lower() == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['thumbnailUrl', 'updatedAt'])
        && request.resource.data.thumbnailUrl is string;
      match /posts/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.posterEmail == request.auth.token.email
          && request.resource.data.type in ['Task', 'Announcement'];
        allow update, delete: if request.auth != null
          && resource.data.posterEmail == request.auth.token.email;

        match /comments/{commentId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && request.resource.data.authorEmail == request.auth.token.email
            && request.resource.data.authorRole in ['Teacher', 'Student']
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0;
          allow update, delete: if request.auth != null
            && resource.data.authorEmail == request.auth.token.email;
        }

        match /submissions/{studentEmail} {
          allow read: if request.auth != null
            && (isDashboardAdmin()
              || isAuthenticatedAs(studentEmail)
              || (managesTask(subjectId, postId)
                && get(/databases/$(database)/documents/subjects/$(subjectId)/posts/$(postId)).data.type == 'Task'));
          allow create: if request.auth != null
            && (isAuthenticatedAs(studentEmail)
              || (managesTask(subjectId, postId)
                && get(/databases/$(database)/documents/subjects/$(subjectId)/posts/$(postId)).data.type == 'Task'
                && request.resource.data.keys().hasOnly([
                  'studentEmail', 'studentName', 'answer', 'scanUrl', 'scanUrls',
                  'status', 'reviewStatus', 'gradingSource', 'submittedAt',
                  'score', 'feedback'
                ])
                && request.resource.data.studentEmail == studentEmail
                && request.resource.data.studentName is string
                && request.resource.data.answer is string
                && request.resource.data.scanUrl is string
                && request.resource.data.scanUrls is list
                && request.resource.data.scanUrls.size() > 0
                && request.resource.data.status == 'Submitted'
                && request.resource.data.reviewStatus == 'pending_review'
                && request.resource.data.gradingSource == 'ai_pending_human_review'
                && request.resource.data.submittedAt is timestamp
                && request.resource.data.score == null
                && request.resource.data.feedback == null));
          allow update: if request.auth != null
            && isAuthenticatedAs(studentEmail)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['studentEmail', 'studentName', 'answer', 'scanUrl', 'scanUrls',
                'status', 'submittedAt', 'draftScanUrls', 'draftUpdatedAt',
                'reviewStatus', 'gradingSource', 'score', 'feedback']);
          allow update: if request.auth != null
            && managesTask(subjectId, postId)
            && get(/databases/$(database)/documents/subjects/$(subjectId)/posts/$(postId)).data.type == 'Task';
        }
      }
    }

    // Collection-group reads are restricted to dashboard admins.
    match /{path=**}/posts/{postId} {
      allow read: if isDashboardAdmin();
    }

    match /{path=**}/submissions/{studentEmail} {
      allow read: if isDashboardAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource.data.studentEmail == request.auth.token.email
          || resource.data.instructorEmail == request.auth.token.email);
      allow create: if request.auth != null
        && (request.resource.data.studentEmail == request.auth.token.email
          || request.resource.data.instructorEmail == request.auth.token.email);
      allow update: if request.auth != null
        && (resource.data.studentEmail == request.auth.token.email
          || resource.data.instructorEmail == request.auth.token.email);
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentEmail == request.auth.token.email
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.instructorEmail == request.auth.token.email);
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.studentEmail == request.auth.token.email
            || get(/databases/$(database)/documents/conversations/$(conversationId)).data.instructorEmail == request.auth.token.email)
          && request.resource.data.senderEmail == request.auth.token.email;
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      }
    }

    match /rubric_templates/{templateId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isDashboardAdmin();

      match /csv_chunks/{chunkId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isDashboardAdmin();
      }
    }

  }
}
